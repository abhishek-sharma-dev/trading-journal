# Server Configuration
PORT=3000
DOMAIN=http://localhost:3000

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Payment Gateway (Optional)
# If left blank, the server automatically defaults to the Sandbox Payment Gateway Simulator for checkout testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI Mentor (Optional)
# If left blank, the server automatically defaults to the local trade analysis advisor.
# Add your Google Gemini API key to activate advanced dynamic conversational trade coaching!
GEMINI_API_KEY=
